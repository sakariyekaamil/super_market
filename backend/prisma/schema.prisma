generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  ZAAD
  EDAHAB
  CARD
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  fullName     String   @map("full_name")
  username     String   @unique
  password     String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now()) @map("created_at")
  refreshToken String?  @map("refresh_token")

  purchases Purchase[]
  sales     Sale[]

  @@map("users")
}

model Category {
  categoryId   Int    @id @default(autoincrement()) @map("category_id")
  categoryName String @unique @map("category_name")
  description  String?

  products Product[]

  @@map("categories")
}

model Supplier {
  supplierId   Int    @id @default(autoincrement()) @map("supplier_id")
  supplierName String @map("supplier_name")
  phone        String?
  address      String?

  products  Product[]
  purchases Purchase[]

  @@map("suppliers")
}

model Product {
  productId    Int     @id @default(autoincrement()) @map("product_id")
  productName  String  @map("product_name")
  categoryId   Int     @map("category_id")
  supplierId   Int     @map("supplier_id")
  barcode      String? @unique
  buyingPrice  Decimal @map("buying_price") @db.Decimal(12, 2)
  sellingPrice Decimal @map("selling_price") @db.Decimal(12, 2)
  quantity     Int     @default(0)

  category        Category         @relation(fields: [categoryId], references: [categoryId], onDelete: Restrict)
  supplier        Supplier         @relation(fields: [supplierId], references: [supplierId], onDelete: Restrict)
  purchaseDetails PurchaseDetail[]
  saleItems       SaleItem[]

  @@map("products")
}

model Customer {
  customerId Int    @id @default(autoincrement()) @map("customer_id")
  fullName   String @map("full_name")
  phone      String?
  address    String?

  sales Sale[]

  @@map("customers")
}

model Purchase {
  purchaseId   Int      @id @default(autoincrement()) @map("purchase_id")
  supplierId   Int      @map("supplier_id")
  userId       Int      @map("user_id")
  purchaseDate DateTime @default(now()) @map("purchase_date")
  totalAmount  Decimal  @map("total_amount") @db.Decimal(12, 2)

  supplier Supplier         @relation(fields: [supplierId], references: [supplierId], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [userId], onDelete: Restrict)
  details  PurchaseDetail[]

  @@map("purchases")
}

model PurchaseDetail {
  purchaseDetailId Int     @id @default(autoincrement()) @map("purchase_detail_id")
  purchaseId       Int     @map("purchase_id")
  productId        Int     @map("product_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [purchaseId], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [productId], onDelete: Restrict)

  @@map("purchase_details")
}

model Sale {
  saleId    Int      @id @default(autoincrement()) @map("sale_id")
  customerId Int?    @map("customer_id")
  userId    Int      @map("user_id")
  saleDate  DateTime @default(now()) @map("sale_date")
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)

  customer Customer?  @relation(fields: [customerId], references: [customerId], onDelete: SetNull)
  user     User       @relation(fields: [userId], references: [userId], onDelete: Restrict)
  items    SaleItem[]
  payment  Payment?

  @@map("sales")
}

model SaleItem {
  saleItemId Int     @id @default(autoincrement()) @map("sale_item_id")
  saleId     Int     @map("sale_id")
  productId  Int     @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  subTotal   Decimal @map("sub_total") @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [saleId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Restrict)

  @@map("sale_items")
}

model Payment {
  paymentId     Int           @id @default(autoincrement()) @map("payment_id")
  saleId        Int           @unique @map("sale_id")
  paymentMethod PaymentMethod @map("payment_method")
  paidAmount    Decimal       @map("paid_amount") @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  changeAmount  Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  paymentDate   DateTime      @default(now()) @map("payment_date")

  sale Sale @relation(fields: [saleId], references: [saleId], onDelete: Cascade)

  @@map("payments")
}

model Employee {
  employeeId Int            @id @default(autoincrement()) @map("employee_id")
  fullName   String         @map("full_name")
  phone      String?
  position   String
  salary     Decimal        @db.Decimal(12, 2)
  hireDate   DateTime       @default(now()) @map("hire_date")
  status     EmployeeStatus @default(ACTIVE)

  salaryPayments SalaryPayment[]

  @@map("employees")
}

model SalaryPayment {
  salaryPaymentId Int      @id @default(autoincrement()) @map("salary_payment_id")
  employeeId      Int      @map("employee_id")
  amount          Decimal  @db.Decimal(12, 2)
  paymentMonth    Int      @map("payment_month")
  paymentYear     Int      @map("payment_year")
  paymentDate     DateTime @default(now()) @map("payment_date")

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)

  @@unique([employeeId, paymentMonth, paymentYear])
  @@map("salary_payments")
}
